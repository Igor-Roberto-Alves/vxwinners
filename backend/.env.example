# Copie para .env e preencha. O .env fica FORA do git (já está no .gitignore). Nunca commite credenciais.
# Em desenvolvimento o backend também procura o .env na pasta do repositório e na pasta acima dela.

# Banco. Vazio: desenvolvimento sobe um PostgreSQL embutido em backend/.pgdata (não use isso em produção).
DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/cadastro

# Autenticação: só "dev" existe (cabeçalhos X-Usuario e X-Papel). A API recusa subir com outro valor.
AUTH_MODO=dev

# Frontend (CORS), origens separadas por vírgula.
CORS_ORIGENS=http://localhost:5173

# --- LLM -------------------------------------------------------------------------------------
LLM_HABILITADO=true
LLM_PROVIDER=bedrock                  # bedrock | aws_platform
AWS_DEFAULT_REGION=us-east-1
# Credenciais AWS. Prefira um papel IAM; as temporárias abaixo expiram.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Modelos: dependem da conta (política de modelos permitidos). IDs de perfil de inferência no Bedrock.
LLM_MODELO_EXTRACAO=us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_MODELO_DIFICIL=us.anthropic.claude-sonnet-5
LLM_CONCORRENCIA=8

# Claude Platform on AWS (LLM_PROVIDER=aws_platform): IDs de modelo sem prefixo e estas duas variáveis.
# AWS_REGION=us-east-1
# ANTHROPIC_AWS_WORKSPACE_ID=

# --- Conector do ERP (arquivos) -------------------------------------------------------------
# ERP_DIR_SAIDA=./erp_out
# ERP_DIR_ENTRADA=./erp_in
